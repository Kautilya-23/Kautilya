{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json", "version": 1, "newProjectRoot": "projects",
  "projects": { "opd-frontend": { "projectType": "application", "root": "", "sourceRoot": "src", "prefix": "app",
    "architect": {
      "build": { "builder": "@angular-devkit/build-angular:application",
        "options": { "outputPath": "dist/opd-frontend", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"],
          "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"] },
        "configurations": { "production": { "outputHashing": "all" }, "development": { "optimization": false, "sourceMap": true } }, "defaultConfiguration": "production" },
      "serve": { "builder": "@angular-devkit/build-angular:dev-server",
        "configurations": { "production": { "buildTarget": "opd-frontend:build:production" }, "development": { "buildTarget": "opd-frontend:build:development" } }, "defaultConfiguration": "development" }
    }
  }
},
"cli": {
  "analytics": "82998244-4e16-444c-9533-6f76d9f91f71"
}
}
